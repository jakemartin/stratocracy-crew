%% Stratocracy Agent Crew — roles, tools, and data flow (GDD §3 headless crew)
flowchart TD
    D["🎯 Director (human)<br/>spec/combat_spec.md"]

    subgraph CREW["CrewAI sequential crew"]
        SE["🛠 Systems Engineer<br/>authors headless C++"]
        TE["✅ Test Engineer<br/>compile + test gate"]
        BA["📊 Balance Analyst<br/>self-play + tuning"]
    end

    IMPL[("build/Combat.cpp")]
    REPORT[("build/balance_report.md")]

    D -->|"input spec (contract)"| SE
    SE -->|"tool: write_combat_impl"| IMPL
    IMPL --> TE
    TE -->|"tool: run_test_gate<br/>(real g++ compile + run)"| GATE{"T-COMBAT-01..08<br/>all pass?"}
    GATE -->|"BLOCK — e.g. T-COMBAT-07<br/>hallucinated counter rule"| SE
    GATE -->|"PASS — merge approved"| BA
    BA -->|"tool: run_self_play"| REPORT
    REPORT -->|"tuning proposal"| D

    classDef human fill:#33260c,stroke:#6b4d16,color:#ffe1b0;
    classDef agent fill:#171b21,stroke:#5aa9ff,color:#e7ecf2;
    classDef data fill:#12301f,stroke:#1c5b3b,color:#bff0d0;
    class D human;
    class SE,TE,BA agent;
    class IMPL,REPORT data;
